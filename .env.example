# ============================================================
# ParcelPilot AI Support Agent - environment configuration
# Copy to backend/.env (never commit the real .env)
# ============================================================

# --- LLM ---
# Provider: 'gemini'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash

# Auth - HMAC secret signing login tokens (set a strong random value in prod)
AUTH_SECRET=dev-only-change-me-parcelpilot

# --- Data locations ---
# Folder containing the candidate data pack (6 PDFs + ParcelPilot_Assessment_Data.xlsx)
DATA_PACK_DIR=./data_pack
SQLITE_DB_PATH=./data/parcelpilot.db
VECTOR_STORE_DIR=./data/chroma

# --- Time reference ---
# All time-based logic uses the dataset snapshot time declared in the
# workbook's README sheet. Set this ONLY to override it (ISO 8601), e.g. for tests.
# SNAPSHOT_TIME_OVERRIDE=2025-06-30T12:00:00Z

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Frontend (put in frontend/.env.local instead) ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
